{
  "name": "tadka-ts",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": { "node": ">=24 <27" },
  "scripts": {
    "dev": "pnpm -r --parallel --no-bail run dev",
    "build": "pnpm -r run typecheck && pnpm --filter @tadka/web build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "db:migrate": "pnpm --filter @tadka/api db:migrate",
    "db:seed": "pnpm --filter @tadka/api db:seed",
    "probe:llm": "pnpm --filter @tadka/api probe:llm"
  }
}
