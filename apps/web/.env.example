# Read by Vite (apps/web), not by the API. Variables starting with VITE_ are compiled into the bundle:
# never put a secret in one.
#
# Where the API is. Default: http://localhost:3000
# VITE_API_URL=http://localhost:3000
#
# "1" turns on the built-in demo sign-in (Rahul and Aman, with the seed password) and signs in as Rahul on load.
# `pnpm dev` sets it through apps/web/.env.development. A production build leaves it OFF: the demo accounts
# are then not in the bundle at all. For a recorded demo build: VITE_DEMO_LOGIN=1 pnpm --filter @tadka/web build
# VITE_DEMO_LOGIN=1
