# Copy to .env. Never commit .env.
DATABASE_URL=postgres://tadka:tadka_local@localhost:5544/tadka
FAKE_PSP_URL=http://localhost:4010
# Optional: leave unset to run without tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# The model provider: azure (Microsoft Foundry) or openai. LEAVE IT EMPTY until you have credentials: with it empty
# the API starts without a model (triage answers 503 provider_not_configured; set DEMO_MODE=1 below for simulated
# answers). If you set it, fill in the matching credentials too: an incomplete choice stops the API at startup
# with a one-line message instead of silently running without the model you asked for.
LLM_PROVIDER=
# The model the budget prices. Not the Azure deployment name.
LLM_MODEL=gpt-5.4-mini
# For LLM_PROVIDER=azure: a Microsoft Foundry resource with a
# gpt-5.4-mini deployment (Global Standard). Resource name is the <name> in https://<name>.openai.azure.com
AZURE_RESOURCE_NAME=
AZURE_API_KEY=
AZURE_DEPLOYMENT=gpt-5.4-mini
# For LLM_PROVIDER=openai: your key for the direct OpenAI API. Needs a price row in apps/api/src/llm/pricing.ts.
OPENAI_API_KEY=
M0_BUDGET_USD=5
# Where browsers may call the API from. Empty = http://localhost:5173 and :4173 (and the 127.0.0.1 forms).
CORS_ORIGIN=
# POST /assist/triage without a real model. "1" = answer with a SIMULATED result (nothing is sent to a provider),
# "0" or empty = off. Anything else refuses to start. With it off and no provider configured, triage answers
# 503 provider_not_configured. Set it to 1 here if you have no Azure/OpenAI credentials and want the browser demo.
DEMO_MODE=0
# POST /assist/triage limits. The rate limit is per signed-in user and in memory (per process): basic abuse
# protection, NOT a spending cap. The budget ledger (M0_BUDGET_USD) only guards `pnpm probe:llm -- --live`.
TRIAGE_RATE_LIMIT_PER_MIN=10
TRIAGE_TIMEOUT_MS=15000
# The web client (apps/web) reads VITE_* variables from apps/web/.env*, not from this file: see apps/web/.env.example.
