# Copy to .env. Never commit .env.
DATABASE_URL=postgres://tadka:tadka_local@localhost:5544/tadka
FAKE_PSP_URL=http://localhost:4010
# Optional: leave unset to run without tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Only needed for `pnpm probe:llm -- --live`, the live evaluation and POST /assist/chat. Choose the provider: azure (Microsoft Foundry) or openai.
LLM_PROVIDER=azure
# The model the budget prices. Not the Azure deployment name.
LLM_MODEL=gpt-5.4-mini
# For LLM_PROVIDER=azure: a Microsoft Foundry resource with a
# gpt-5.4-mini deployment (Global Standard). Resource name is the <name> in https://<name>.openai.azure.com
AZURE_RESOURCE_NAME=
AZURE_API_KEY=
AZURE_DEPLOYMENT=gpt-5.4-mini
# For LLM_PROVIDER=openai: your key for the direct OpenAI API. Needs a price row in apps/api/src/llm/pricing.ts.
OPENAI_API_KEY=
M0_BUDGET_USD=5
# Spending cap for one `pnpm eval:intent --live` run, on top of M0_BUDGET_USD
EVAL_BUDGET_USD=0.5
# POST /assist/chat spending guard (RUNBOOK section 7). The defaults are fine. The price comes from LLM_PROVIDER and LLM_MODEL.
ASSIST_MAX_OUTPUT_TOKENS=400
ASSIST_TURN_BUDGET_USD=0.05
ASSIST_ESTIMATE_MARGIN=1.25
# Key for hashing order ids in logs/security-audit.jsonl. Empty = a new key each start.
AUDIT_HMAC_KEY=
