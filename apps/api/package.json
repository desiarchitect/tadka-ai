{
  "name": "@tadka/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --import ./src/instrument.ts src/main.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=../../.env --import tsx scripts/seed.ts",
    "probe:llm": "node --env-file-if-exists=../../.env --import tsx scripts/probe-llm.ts"
  },
  "dependencies": {
    "@ai-sdk/azure": "4.0.99",
    "@fastify/cors": "10.0.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-pg": "0.75.0",
    "@opentelemetry/instrumentation-undici": "0.33.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "ai": "7.0.137",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
